# The public Firebase project defaults are built into the app. `apiKey` is mapped to the client bundle.
# Override these only if the Firebase web app configuration changes.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=

# Firebase Admin service account (server-only; never use NEXT_PUBLIC_)
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Optional: required only for Firebase Storage image uploads; Firestore works without it.
FIREBASE_STORAGE_BUCKET=

# Required in production for privacy-preserving form throttling and duplicate checks
FIREBASE_RATE_LIMIT_SECRET=

# Temporary one-time bootstrap values. Remove both after the first administrator is provisioned.
FIREBASE_ADMIN_BOOTSTRAP_EMAIL=
FIREBASE_ADMIN_BOOTSTRAP_SECRET=
