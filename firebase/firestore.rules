rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdministrator() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /events/{id} {
      allow read: if isAdministrator() || resource.data.status == 'published';
      allow write: if isAdministrator();
    }

    match /programs/{id} {
      allow read: if isAdministrator() || resource.data.status == 'published';
      allow write: if isAdministrator();
    }

    match /projects/{id} {
      allow read: if isAdministrator() || resource.data.status == 'published';
      allow write: if isAdministrator();
    }

    match /posts/{id} {
      allow read: if isAdministrator() || resource.data.status == 'published';
      allow write: if isAdministrator();
    }

    match /gallery/{id} {
      allow read: if isAdministrator() || resource.data.status == 'published';
      allow write: if isAdministrator();
    }

    match /impact/{id} {
      allow read: if isAdministrator() || resource.data.status == 'published';
      allow write: if isAdministrator();
    }

    match /settings/{id} {
      allow read: if isAdministrator() || id == 'public';
      allow write: if isAdministrator();
    }

    match /users/{id} {
      allow read, write: if isAdministrator();
    }

    match /registrations/{id} {
      allow read, write: if isAdministrator();
    }

    match /messages/{id} {
      allow read, write: if isAdministrator();
    }

    match /_rate_limits/{id} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
